# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL="mongodb://127.0.0.1:27017/turf?directConnection=true"

# --- Auth / JWT ---
JWT_SECRET="replace-with-a-long-random-string"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Gateway secret encryption (32-byte key, hex or passphrase) ---
ENCRYPTION_KEY=""

# --- Email / SMTP ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="noreply@turf.local"
SMTP_ENABLED=false

# --- Seed admin ---
ADMIN_EMAIL="admin@crm.local"
ADMIN_PASSWORD="Admin@123"

# --- App ---
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8000"
HOLD_TTL_MINUTES=10
PAYOUT_MODE="AUTO"
